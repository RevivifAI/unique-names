{
  "name": "@revivifai/unique-names",
  "version": "1.0.0",
  "description": "Generate unique, memorable names using WordNet dictionaries",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "lefthook install",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "unique",
    "names",
    "generator",
    "haikunator",
    "wordnet",
    "random",
    "identifiers",
    "human-readable"
  ],
  "author": "RevivifAI",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RevivifAI/unique-names.git"
  },
  "bugs": {
    "url": "https://github.com/RevivifAI/unique-names/issues"
  },
  "homepage": "https://github.com/RevivifAI/unique-names#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@revivifai/eslint-config": "^1.3.0",
    "@types/node": "^25.9.0",
    "@vitest/eslint-plugin": "^1.6.17",
    "eslint": "^10.4.0",
    "lefthook": "^2.1.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  }
}